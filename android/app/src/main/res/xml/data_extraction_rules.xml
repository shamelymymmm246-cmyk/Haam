<?xml version="1.0" encoding="utf-8"?>
<!--
  المرحلة 4 — طبقة 4-ز.5 (Android 12+، API 31+).
  نمنع نقل/نسخ بيانات التطبيق احتياطياً أو عند نقل الجهاز (cloud + device-transfer)
  لأن الخزنة وبيانات الأمان محلية حسّاسة ولا يجب أن تغادر الجهاز.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
